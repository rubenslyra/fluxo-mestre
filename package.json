{
  "name": "fluxolab",
  "version": "0.2.0",
  "description": "Criador de fluxogramas ISO 5807 com desafios de logica, geracao local por IA e blueprints de codigo.",
  "author": "Rubens Lyra (@rubinholyralabs)",
  "license": "CC-BY-NC-SA-4.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vite build",
    "build:fluxolab": "vite build --base=/fluxolab/",
    "build:static": "vite build --config vite.static.config.ts",
    "build:hostinger": "bun run build:static && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-hostinger.ps1",
    "build:hostinger:fluxlab": "cross-env FLUXOLAB_BASE_PATH=/fluxlab/ bun run build:static && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-hostinger.ps1 -PackageName fluxlab-hostinger.zip -ServerPath public_html/fluxlab/",
    "build:dev": "vite build --mode development",
    "test": "bun test",
    "preview": "vite preview",
    "browser:smoke": "bun scripts/browser-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "1.170.7",
    "@tanstack/react-start": "1.168.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  }
}
